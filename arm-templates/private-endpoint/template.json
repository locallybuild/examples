{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "The Azure Region (or Locally Region) to deploy the resources into."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2025-07-01",
      "name": "example-vnet-from-armtemplate",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        }
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2025-07-01",
      "name": "example-vnet-from-armtemplate/subnet-1",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'example-vnet-from-armtemplate')]"
      ],
      "properties": {
        "addressPrefix": "10.0.1.0/24"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2026-06-01",
      "name": "expearmtemplatesa",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2025-07-01",
      "name": "example-private-endpoint-from-armtemplate",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'example-vnet-from-armtemplate', 'subnet-1')]",
        "[resourceId('Microsoft.Storage/storageAccounts', 'expearmtemplatesa')]"
      ],
      "properties": {
        "subnet": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'example-vnet-from-armtemplate', 'subnet-1')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "example-connection-from-armtemplate",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Storage/storageAccounts', 'expearmtemplatesa')]",
              "groupIds": [
                "blob"
              ]
            }
          }
        ]
      }
    }
  ]
}
