{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resources": [
    {
      "comments": "This is a local emulator example - real deployments should pass the administrator password in from a secret (e.g. a securestring parameter sourced from Key Vault).",
      "type": "Microsoft.DBforMySQL/flexibleServers",
      "apiVersion": "2024-12-30",
      "name": "example-mysql-from-armtemplate",
      "location": "berlin",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "8.0.21",
        "storage": {
          "storageSizeGB": 20
        },
        "administratorLogin": "exampleadmin",
        "administratorLoginPassword": "Example-Passw0rd!"
      }
    },
    {
      "type": "Microsoft.DBforMySQL/flexibleServers/databases",
      "apiVersion": "2024-12-30",
      "name": "example-mysql-from-armtemplate/example-database",
      "properties": {
        "charset": "utf8mb4",
        "collation": "utf8mb4_unicode_ci"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforMySQL/flexibleServers', 'example-mysql-from-armtemplate')]"
      ]
    }
  ]
}
