{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "adminUsername": {
      "type": "string",
      "defaultValue": "adminuser"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2025-07-01",
      "name": "example-vnet-from-armtemplate",
      "location": "berlin",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        }
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2025-07-01",
      "name": "example-vnet-from-armtemplate/subnet-1",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'example-vnet-from-armtemplate')]"
      ],
      "properties": {
        "addressPrefix": "10.0.1.0/24"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2025-07-01",
      "name": "example-nic-from-armtemplate",
      "location": "berlin",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'example-vnet-from-armtemplate', 'subnet-1')]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "internal",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'example-vnet-from-armtemplate', 'subnet-1')]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2026-04-01",
      "name": "example-vm-from-armtemplate",
      "location": "berlin",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'example-nic-from-armtemplate')]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B1s"
        },
        "osProfile": {
          "computerName": "example-vm",
          "adminUsername": "[parameters('adminUsername')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",
                  "keyData": "ssh-rsa  example@example.com"
                }
              ]
            }
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "caching": "ReadWrite",
            "deleteOption": "Delete",
            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'example-nic-from-armtemplate')]"
            }
          ]
        }
      }
    }
  ]
}
