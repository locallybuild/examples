{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2026-06-01",
      "name": "exblobarmtemplate",
      "location": "berlin",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2026-06-01",
      "name": "exblobarmtemplate/default/example-container-from-armtemplate",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', 'exblobarmtemplate')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    }
  ]
}
